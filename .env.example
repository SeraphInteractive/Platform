# ==============================================================================
# PROJECT STAIRWAY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env. Values marked (required) must be set.
# Generate secrets with: openssl rand -base64 48
# ==============================================================================

# ---- 1. RUNTIME & SERVER -----------------------------------------------------
NODE_ENV=production
PORT=3333
LOG_LEVEL=info
# json in containers, pretty for local development
LOG_FORMAT=json
# Number of reverse proxies in front of the api (Traefik = 1); 0 when exposed directly
TRUST_PROXY_HOPS=1

# ---- 2. SECURITY & AUTHENTICATION -------------------------------------------
# (required) Public https url of this api
APP_URL=https://api.example.com
# (required) 32+ random characters; keys the pseudonymous ballot ledger
APP_KEY=
# (required) Comma-separated web app origins allowed to call the api and receive logins
# The first origin is the default login redirect target. Wildcards are not supported.
CORS_ORIGINS=https://app.example.com
# Path on the web app that receives #code=... after Discord login
WEB_AUTH_CALLBACK_PATH=/auth/callback
SESSION_TTL_DAYS=30
# (required by docker compose) 32+ character secret shared by the api and the Discord bot
SERVICE_TOKEN=

# ---- 3. POSTGRES DATABASE ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
# Schema owner, used only by migrations
DB_USER=platform
# (required)
DB_PASSWORD=
# Docker compose: least-privilege role the api connects as (created on first db start)
APP_DB_USER=platform_app
# (required by docker compose)
APP_DB_PASSWORD=
DB_DATABASE=platform
# disable | require | verify-full
DB_SSL=disable
DB_POOL_MAX=20

# ---- 4. REDIS CACHE & LOCKING ------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# (required in production) Use hex or base64 characters, e.g. openssl rand -hex 32
REDIS_PASSWORD=
REDIS_TLS=false
# Docker compose only: memory cap for the redis container
REDIS_MAXMEMORY=128mb

# ---- 5. DISCORD OAUTH APPLICATION -------------------------------------------
# (required) Discord application credentials (shared by web login and the bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# (required) Register in the Discord developer portal: <APP_URL>/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI=https://api.example.com/api/v1/auth/discord/callback

# ---- 6. DISCORD BOT & WEBHOOKS ----------------------------------------------
# (required by docker compose) Bot token from the developer portal
DISCORD_BOT_TOKEN=
# (required by docker compose) The studio guild the bot serves; ignores other servers
DISCORD_GUILD_ID=
# (optional) Explicit announcements channel ID override
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
# (required by docker compose) Web app origin used for "vote on the web" and docs links
WEB_APP_URL=https://app.example.com
# (optional) Storage/CDN origins the web app may load media from and upload to, comma-separated
WEB_STORAGE_ORIGINS=https://media.example.com,https://bucket.s3.example.com
# (optional) Public Discord invite shown in the web app sidebar
DISCORD_INVITE_URL=https://discord.gg/WP7dhVzkaV

# Global Discord Webhook Endpoints
# Department-specific webhooks (info, task logs) are provisioned dynamically by the bot
# and persisted directly in the database (department_discord_maps table).
DISCORD_TELEMETRY_WEBHOOK_URL=
DISCORD_MODERATION_LOGS_WEBHOOK_URL=
DISCORD_RULES_WEBHOOK_URL=

# ---- 7. ROLE ASSIGNMENT ------------------------------------------------------
# Comma-separated Discord user IDs assigned on login
# At most two users for super admin; cannot be granted or revoked from the web app
SUPER_ADMIN_DISCORD_IDS=
ADMIN_DISCORD_IDS=
SUPERVISOR_DISCORD_IDS=
SENIOR_DISCORD_IDS=

# ---- 8. MEMBER VERIFICATION (RESEND & TURNSTILE) ----------------------------
# (required in production) Resend API key and sender on a verified domain
RESEND_API_KEY=
EMAIL_FROM=Stairway <verify@example.com>
# (required in production) Cloudflare Turnstile keys; hostname must match a CORS origin
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ---- 9. STORAGE: S3 / CLOUDFLARE R2 -----------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for shot deliverables (downloads use short-lived signed urls)
S3_DELIVERABLES_BUCKET=
# Public bucket for entry media, served from S3_MEDIA_PUBLIC_URL (https)
S3_MEDIA_BUCKET=
S3_MEDIA_PUBLIC_URL=
MEDIA_MAX_BYTES=5242880
DELIVERABLE_MAX_BYTES=2147483648

# ---- 10. STORAGE: NEXTCLOUD WEBDAV ------------------------------------------
# Deliverables and production pipeline vault
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_BASE_PATH=/remote.php/dav/files
NEXTCLOUD_PUBLIC_URL=

# ---- 11. STUDIO SCREENPLAY SERVICE -------------------------------------------
SCRIPT_INTERNAL_URL=http://script:3000
