        "@fastify/cors": "^11.3.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/swagger": "^9.9.2",
        "@platform/contracts": "2.0.0",
        "@platform/scoring": "2.0.0",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "fastify-plugin": "^6.0.1",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "pino": "^10.4.0",
